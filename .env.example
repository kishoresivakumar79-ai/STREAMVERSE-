# ========================================================
# STREAMVERSE Environment Configuration
# ========================================================

# App Settings
APP_NAME=STREAMVERSE
APP_ENV=development
SECRET_KEY=streamverse_super_secret_jwt_key_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://streamverse_user:streamverse_pass@localhost:5432/streamverse_db

# Redis Cache (Optional for fast caching)
REDIS_URL=redis://localhost:6379/0

# TMDB API Configuration (Get your free API key at https://www.themoviedb.org/settings/api)
# Note: For demo/offline mode without a key, the backend includes built-in fallback mock data!
TMDB_API_KEY=YOUR_TMDB_API_KEY_HERE
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# Default Regional OTT Filtering
DEFAULT_REGION=IN

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

